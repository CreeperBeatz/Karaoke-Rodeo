# karaoke.rodeo configuration (copy to .env). Values here are read by server/ and worker.py.

# Public origin. https:// turns on Secure cookies. On the Pi behind the tunnel: https://karaoke.rodeo
BASE_URL=http://127.0.0.1:8765
HOST=127.0.0.1
PORT=8765

# Resend (https://resend.com) — verify the karaoke.rodeo domain there and add its SPF/DKIM DNS records.
# Leave RESEND_API_KEY empty for DEV_MODE: no mail is sent, the login link is printed and shown in the UI.
RESEND_API_KEY=
MAIL_FROM=karaoke.rodeo <no-reply@karaoke.rodeo>
# DEV_MODE=0   # force real mail even without a key (will fail) / 1 to force dev links

# Comma-separated admin accounts (see the add-song form, the job queue and the labeling tool)
ADMIN_EMAILS=

# Where runtime state lives (DB, videos, maps, caches, avatars). Default: <repo>/data
# KARAOKE_DATA=/srv/karaoke/data
# KARAOKE_WORKERS=3          # geotime decode workers (Pi 4: 3)
# FFMPEG=/usr/bin/ffmpeg     # default: PATH, then the imageio-ffmpeg wheel
# SESSION_DAYS=90
# LOGIN_TOKEN_MINUTES=15
