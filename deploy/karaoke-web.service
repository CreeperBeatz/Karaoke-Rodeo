[Unit]
Description=karaoke.rodeo web (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=PYTHONUTF8=1
ExecStart=__APP_DIR__/.venv/bin/python -m server
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
